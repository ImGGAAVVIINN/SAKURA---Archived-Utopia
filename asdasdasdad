// Draw arc segment using Win32 Arc()
static void drawArcSegment(HDC hdc, int cx, int cy, int r,
                           double startDeg, double endDeg, HPEN pen)
{
    if (endDeg < startDeg) std::swap(startDeg, endDeg);
    double sRad = startDeg * M_PI / 180.0;
    double eRad = endDeg   * M_PI / 180.0;
    int x1 = cx + static_cast<int>(std::cos(sRad) * r);
    int y1 = cy - static_cast<int>(std::sin(sRad) * r);
    int x2 = cx + static_cast<int>(std::cos(eRad) * r);
    int y2 = cy - static_cast<int>(std::sin(eRad) * r);
    Arc(hdc, cx - r, cy - r, cx + r, cy + r, x1, y1, x2, y2);
    DeleteObject(pen);
}

// Draw gear-teeth ring around wheel
static void drawGearTeeth(HDC hdc, int cx, int cy, int outerR, int innerR,
                          COLORREF colTeeth, COLORREF colBg, int count)
{
    HBRUSH bgBrush = CreateSolidBrush(colBg);
    HBRUSH toothBrush = CreateSolidBrush(colTeeth);
    HPEN penNull = (HPEN)SelectObject(hdc, GetStockObject(NULL_PEN));

    SelectObject(hdc, bgBrush);
    Ellipse(hdc, cx - outerR, cy - outerR, cx + outerR, cy + outerR);

    for (int i = 0; i < count; ++i)
    {
        double a = i * 2.0 * M_PI / count;
        int tx = cx + static_cast<int>(std::cos(a) * (outerR - 2));
        int ty = cy - static_cast<int>(std::sin(a) * (outerR - 2));
        RECT tr = {tx - 1, ty - 2, tx + 2, ty + 1};
        FillRect(hdc, &tr, toothBrush);
    }

    SelectObject(hdc, penNull);
    DeleteObject(bgBrush);
    DeleteObject(toothBrush);
}

// Draw wheel arc (rail + highlight fill)
static void drawWheelArc(HDC hdc, int cx, int cy, int r,
                         float value, COLORREF colRail, COLORREF colFill)
{
    HPEN railPen = CreatePen(PS_SOLID, 4, colRail);
    drawArcSegment(hdc, cx, cy, r, kArcStartDeg, kArcEndDeg, railPen);

    double valAngle = kArcStartDeg + value * kArcSpanDeg;
    HPEN fillPen = CreatePen(PS_SOLID, 4, colFill);
    drawArcSegment(hdc, cx, cy, r, kArcStartDeg, valAngle, fillPen);
}

