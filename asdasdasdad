// Form dimensions (from TSynthEditorForm in editor_layout.json)
constexpr int kEditorWidth  = 530;
constexpr int kEditorHeight = 160;
constexpr int kNumParams    = 17;

// --- Delphi BGR color constants from original DLL --------------------------
inline COLORREF DelphiColor(std::int32_t bgr_int)
{
    std::uint8_t r = static_cast`std::uint8_t`((bgr_int >> 16) & 0xFF);
    std::uint8_t g = static_cast`std::uint8_t`((bgr_int >>  8) & 0xFF);
    std::uint8_t b = static_cast`std::uint8_t`( bgr_int         & 0xFF);
    return RGB(r, g, b);
}

static constexpr std::int32_t kColForm   = 0x00000000; // clBlack
static constexpr std::int32_t kColPanel  = 0x004D4B43; // MainPanel bg
static constexpr std::int32_t kColRail   = 0x004D483F; // Rail/gear teeth
static constexpr std::int32_t kColFill   = 0x005D579B; // Highlight arc
static constexpr std::int32_t kColText   = 0x009F9D95; // Text colour
static constexpr std::int32_t kColCheck  = 0x00FF8080; // Checkbox off

// Arc geometry recovered from paint_65e7d0 decompilation
static constexpr double kArcStartDeg = 244.0;
static constexpr double kArcEndDeg   = 296.0;
static constexpr double kArcSpanDeg  = kArcEndDeg - kArcStartDeg; // 52°

static constexpr int kGearTeeth = 24;
static constexpr int kWheelSize = 36;
static constexpr int kSliderW = 24;
static constexpr int kSliderH = 90;

struct Control {
    int type;     // 0=wheel, 1=slider, 2=switch, 3=checkbox, 4=visual
    int paramIdx;
    int x, y, w, h;
    const char* label;
};

static const Control kControls[] = {
    { 0, kParamLowCut,        12, 57,  kWheelSize, kWheelSize, "Low Cut" },
    { 0, kParamHighDamping,  12, 108, kWheelSize, kWheelSize, "High Damp." },
    { 0, kParamPredelay,     71,  5,  kWheelSize, kWheelSize, "Predelay" },
    { 0, kParamRoomSize,     71, 57,  kWheelSize, kWheelSize, "Room Size" },
    { 0, kParamDiffusion,    71, 108, kWheelSize, kWheelSize, "Diffusion" },
    { 0, kParamDecay,        148, 5,  kWheelSize, kWheelSize, "Decay" },
