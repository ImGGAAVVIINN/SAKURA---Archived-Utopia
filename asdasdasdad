    int iy = cy - static_cast<int>(std::sin(rad) * (cr - 2));
    HPEN indPen = CreatePen(PS_SOLID, 2, RGB(180, 180, 200));
    HPEN oldInd = (HPEN)SelectObject(hdc, indPen);
    MoveToEx(hdc, cx, cy, nullptr);
    LineTo(hdc, ix, iy);
    SelectObject(hdc, oldInd);
    DeleteObject(indPen);
}

// Draw vertical slider
static void drawSlider(HDC hdc, int x, int y, int w, int h,
                       float value, COLORREF colRail, COLORREF colFill,
                       bool hovered, bool focused)
{
    int railPad = 3;
    int railX = x + railPad;
    int railW = w - railPad * 2;
    int railY = y + 4;
    int railH = h - 8;

    HBRUSH railBrush = CreateSolidBrush(colRail);
    HPEN railPen = (HPEN)CreatePen(PS_SOLID, 1, colRail);
    HPEN oldPen = (HPEN)SelectObject(hdc, railPen);
    HBRUSH oldBr = (HBRUSH)SelectObject(hdc, railBrush);
    Rectangle(hdc, railX, railY, railX + railW, railY + railH);
    DeleteObject(railPen);
    SelectObject(hdc, oldPen);
    SelectObject(hdc, oldBr);
    DeleteObject(railBrush);

    int fillH = static_cast<int>(value * railH);
    if (fillH > 0)
    {
        HBRUSH fillBrush = CreateSolidBrush(colFill);
        RECT fr = {railX, railY + railH - fillH, railX + railW, railY + railH};
        FillRect(hdc, &fr, fillBrush);
        DeleteObject(fillBrush);
    }

    int handleY = railY + railH - fillH - 6;
    int handleW = w - 4;
    int handleX = x + 2;
    COLORREF handleCol = hovered || focused ? RGB(180, 180, 210) : RGB(100, 100, 130);
    HBRUSH hBrush = CreateSolidBrush(handleCol);
    HPEN hPen = CreatePen(PS_SOLID, 1, RGB(60, 60, 80));
    oldPen = (HPEN)SelectObject(hdc, hPen);
    oldBr  = (HBRUSH)SelectObject(hdc, hBrush);
    RoundRect(hdc, handleX, handleY, handleX + handleW, handleY + 12, 3, 3);
    SelectObject(hdc, oldPen);
    SelectObject(hdc, oldBr);
    DeleteObject(hPen);
    DeleteObject(hBrush);
}

// Draw switch selector
static void drawSwitch(HDC hdc, int x, int y, int w, int h,
                       float value, bool active)
{
    int halfW = w / 2;
    COLORREF thumbCol = value >= 0.5f ? RGB(80, 120, 200) : RGB(60, 60, 80);
    HBRUSH trackBrush = CreateSolidBrush(RGB(40, 40, 60));
    HBRUSH oldBr = (HBRUSH)SelectObject(hdc, trackBrush);
    FillRect(hdc, {x, y, x + w, y + h}, trackBrush);
    DeleteObject(trackBrush);
    SelectObject(hdc, oldBr);

    int thumbH = h - 6;
    int thumbY = y + 3;
    int thumbX = value >= 0.5f ? x + halfW + 2 : x + 2;
    int thumbW = halfW - 4;
    HBRUSH tBrush = CreateSolidBrush(thumbCol);
    HPEN tPen = CreatePen(PS_SOLID, 1, RGB(80, 80, 110));
    HPEN oldPen = (HPEN)SelectObject(hdc, tPen);
    oldBr = (HBRUSH)SelectObject(hdc, tBrush);
    RoundRect(hdc, thumbX, thumbY, thumbX + thumbW, thumbY + thumbH, 4, 4);
    SelectObject(hdc, oldPen);
    SelectObject(hdc, oldBr);
    DeleteObject(tPen);
    DeleteObject(tBrush);

    if (!active) return;
    SetTextColor(hdc, RGB(180, 180, 200));
    SetBkMode(hdc, TRANSPARENT);
    const char* txt = value >= 0.5f ? "M" : "/S";
    TextOutA(hdc, x + w/2 - 8, y + h/2 - 6, txt, lstrlenA(txt));
}

// Draw checkbox LED
static void drawCheckbox(HDC hdc, int x, int y, int w, int h,
                         float value, bool active)
{
    int cx = x + w / 2;
    int cy = y + h / 2;
    int r  = w / 2;

    if (!active)
    {
        HBRUSH gb = CreateSolidBrush(RGB(60, 60, 60));
        HBRUSH oldBr = (HBRUSH)SelectObject(hdc, gb);
        Ellipse(hdc, cx - r, cy - r, cx + r, cy + r);
        SelectObject(hdc, oldBr);
        DeleteObject(gb);
        return;
    }

    COLORREF ringCol = value >= 0.5f ? DelphiColor(kColFill) : DelphiColor(kColCheck);
    HBRUSH ringBrush = CreateSolidBrush(ringCol);
    HPEN ringPen = CreatePen(PS_SOLID, 1, ringCol);
    HPEN oldPen = (HPEN)SelectObject(hdc, ringPen);
    HBRUSH oldBr = (HBRUSH)SelectObject(hdc, ringBrush);
    Ellipse(hdc, cx - r, cy - r, cx + r, cy + r);
    SelectObject(hdc, oldPen);
    SelectObject(hdc, oldBr);
    DeleteObject(ringPen);
    DeleteObject(ringBrush);
}

static void drawLabel(HDC hdc, int x, int y, int w, const char* text)
{
    if (!text || text[0] == '\0') return;
    SetTextColor(hdc, DelphiColor(kColText));
    SetBkMode(hdc, TRANSPARENT);
    TextOutA(hdc, x + w/2 - 20, y + 4, text, static_cast<int>(lstrlenA(text)));
}

struct Editor
{
    AEffect*     effect       = nullptr;
    HWND         hwnd         = nullptr;
    float        values[kNumParams] = {};
    int          draggingCtrl = -1;
    POINT        dragStart    = {};
    float        dragValStart = 0.0f;
};

static int hitTest(const Control* ctrl, int count, int mx, int my)
{
    for (int i = 0; i < count; ++i)
    {
        if (mx >= ctrl[i].x && mx < ctrl[i].x + ctrl[i].w &&
            my >= ctrl[i].y && my < ctrl[i].y + ctrl[i].h)
            return i;
    }
    return -1;
}

LRESULT CALLBACK EditorProc(HWND hwnd, UINT msg, WPARAM wParam, LPARAM lParam)
{
    Editor* ed = nullptr;
    if (msg == WM_NCCREATE)
    {
        auto* cs = reinterpret_cast<CREATESTRUCTA*>(lParam);
        ed = static_cast<Editor*>(cs->lpCreateParams);
        ed->hwnd = hwnd;
        SetWindowLongPtrA(hwnd, GWLP_USERDATA, reinterpret_cast<LONG_PTR>(ed));
        return DefWindowProcA(hwnd, msg, wParam, lParam);
    }
    ed = reinterpret_cast<Editor*>(GetWindowLongPtrA(hwnd, GWLP_USERDATA));

    switch (msg)
    {
        case WM_PAINT:
        {
            if (!ed) return 0;
            PAINTSTRUCT ps;
            HDC hdc = BeginPaint(hwnd, &ps);

            HBRUSH formBr = CreateSolidBrush(DelphiColor(kColForm));
            RECT formRc = {0, 0, kEditorWidth, kEditorHeight};
            FillRect(hdc, &formRc, formBr);
            DeleteObject(formBr);

            HBRUSH panelBr = CreateSolidBrush(DelphiColor(kColPanel));
            RECT panelRc = {0, 0, kEditorWidth, kEditorHeight};
            FillRect(hdc, &panelRc, panelBr);
            DeleteObject(panelBr);

            for (int i = 0; i < kNumControls; ++i)
            {
                const Control& c = kControls[i];
                int cx = c.x + c.w / 2;
                int cy = c.y + c.h / 2;

                if (c.type == 0) // Wheel
                {
                    drawGearTeeth(hdc, cx, cy, c.w/2, c.w/2 - 8,
                                  DelphiColor(kColRail), DelphiColor(kColRail), kGearTeeth);
                    drawWheelArc(hdc, cx, cy, c.w/2 - 4, ed->values[c.paramIdx],
                                 DelphiColor(kColRail), DelphiColor(kColFill));
                    drawWheelCap(hdc, cx, cy, c.w/2 - 10, ed->values[c.paramIdx], false);
                    drawLabel(hdc, c.x, c.y + c.h, c.w, c.label);
                }
                else if (c.type == 1) // Slider
                {
                    drawSlider(hdc, c.x, c.y, c.w, c.h,
                               ed->values[c.paramIdx],
                               DelphiColor(kColRail), DelphiColor(kColFill),
                               false, false);
                    drawLabel(hdc, c.x, c.y + c.h, c.w, c.label);
                }
                else if (c.type == 2) // Switch
                {
                    drawSwitch(hdc, c.x, c.y, c.w, c.h,
                               ed->values[c.paramIdx], true);
                    drawLabel(hdc, c.x, c.y + c.h, c.w, c.label);
                }
                else if (c.type == 3) // Checkbox
                {
                    drawCheckbox(hdc, c.x, c.y, c.w, c.h,
                                 ed->values[c.paramIdx], true);
                    drawLabel(hdc, c.x, c.y + c.h, c.w, c.label);
                }
            }

            // VisualPaint placeholder (point cloud based on RoomSize)
            int roomSizeVal = static_cast<int>(ed->values[kParamRoomSize] * 100.0f);
            int dotCount = std::max(1, roomSizeVal / 5);
            HBRUSH dotBr = CreateSolidBrush(DelphiColor(kColFill));
            for (int dy = 0; dy < dotCount; ++dy)
            {
                for (int dx = 0; dx < dotCount; ++dx)
                {
                    int px = 8 + dx * (144 / dotCount);
                    int py = 8 + dy * (144 / dotCount);
                    RECT dr = {px, py, px + 4, py + 4};
                    FillRect(hdc, &dr, dotBr);
                }
            }
            DeleteObject(dotBr);

            EndPaint(hwnd, &ps);
            return 0;
        }

        case WM_LBUTTONDOWN:
        {
            if (!ed) return 0;
            POINT pt = {GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam)};
            int hi = hitTest(kControls, kNumControls, pt.x, pt.y);
            if (hi >= 0)
            {
                ed->draggingCtrl = hi;
                ed->dragStart = pt;
                ed->dragValStart = ed->values[kControls[hi].paramIdx];
                SetCapture(hwnd);
            }
            return 0;
        }

        case WM_MOUSEMOVE:
        {
            if (!ed || ed->draggingCtrl < 0) return 0;
            POINT pt = {GET_X_LPARAM(lParam), GET_Y_LPARAM(lParam)};
            int deltaY = ed->dragStart.y - pt.y;
            const Control& c = kControls[ed->draggingCtrl];
            float sensitivity = (c.type == 1) ? 1.0f / static_cast<float>(c.h)
                                               : 1.0f / 200.0f;
            float newVal = std::clamp(ed->dragValStart + deltaY * sensitivity, 0.0f, 1.0f);
            ed->values[c.paramIdx] = newVal;
            if (ed->effect && ed->effect->setParameter)
                ed->effect->setParameter(ed->effect, c.paramIdx, newVal);
            InvalidateRect(hwnd, nullptr, TRUE);
            return 0;
        }

        case WM_LBUTTONUP:
        {
            if (ed && ed->draggingCtrl >= 0)
            {
                ed->draggingCtrl = -1;
                ReleaseCapture();
            }
            return 0;
        }

        case WM_CLOSE:
            ShowWindow(hwnd, SW_HIDE);
            return 0;

        case WM_DESTROY:
            if (ed) ed->hwnd = nullptr;
            return 0;

        default:
            return DefWindowProcA(hwnd, msg, wParam, lParam);
    }
}

constexpr const char* kWindowClass = "FruityReeverb2NativeEditor";

void ensureWindowClass(HINSTANCE inst)
{
    static bool registered = false;
    if (registered) return;

    WNDCLASSEXA wc = {};
    wc.cbSize = sizeof(wc);
    wc.style = CS_HREDRAW | CS_VREDRAW;
    wc.lpfnWndProc = EditorProc;
    wc.hInstance = inst;
    wc.hCursor = LoadCursorA(nullptr, MAKEINTRESOURCEA(IDC_ARROW));
    wc.hbrBackground = (HBRUSH)GetStockObject(BLACK_BRUSH);
    wc.lpszClassName = kWindowClass;
    if (RegisterClassExA(&wc))
        registered = true;
}

void guiGetRect(Rect& outRect)
{
    outRect.top    = 0;
    outRect.left   = 0;
    outRect.right  = kEditorWidth;
    outRect.bottom = kEditorHeight;
}

void* guiOpen(AEffect* effect, HWND parentHwnd, HINSTANCE instance)
{
    if (!effect) return nullptr;

    HINSTANCE inst = instance ? instance : GetModuleHandleA(nullptr);
    ensureWindowClass(inst);

    auto* ed = new Editor();
    ed->effect = effect;

    HWND parent = parentHwnd ? parentHwnd : GetDesktopWindow();
    DWORD style = WS_POPUP | WS_VISIBLE | WS_CLIPCHILDREN;

    HWND hwnd = CreateWindowExA(0, kWindowClass, "Fruity Reeverb 2", style,
                                0, 0, kEditorWidth, kEditorHeight,
                                parent, nullptr, inst, ed);
    if (!hwnd) { delete ed; return nullptr; }

    ShowWindow(hwnd, SW_SHOW);
    UpdateWindow(hwnd);
    syncAll(ed);

    return ed;
}

void guiClose(void* editorHandle)
{
    auto* ed = static_cast<Editor*>(editorHandle);
    if (!ed) return;
    if (ed->hwnd) DestroyWindow(ed->hwnd);
    ed->hwnd = nullptr;
    delete ed;
}

static void syncAll(Editor* ed)
{
    if (!ed || !ed->effect) return;
    for (int i = 0; i < kNumParams; ++i)
    {
        if (ed->effect->getParameter)
            ed->values[i] = std::clamp(ed->effect->getParameter(ed->effect, i), 0.0f, 1.0f);
        else
            ed->values[i] = 0.0f;
    }
    if (ed->hwnd && IsWindow(ed->hwnd))
        InvalidateRect(ed->hwnd, nullptr, TRUE);
}

void guiIdle(void* editorHandle)
{
    auto* ed = static_cast<Editor*>(editorHandle);
    if (!ed || !ed->hwnd || !IsWindow(ed->hwnd)) return;
    syncAll(ed);
}

